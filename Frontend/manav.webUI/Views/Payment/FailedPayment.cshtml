@{
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    ViewData["Title"] = "Ödeme Geçici Olarak Kullanılamıyor";
}


<main class="maintenance-page">
    <section class="maintenance-card" role="status" aria-labelledby="maintenance-title">
        <div class="maintenance-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
                <path d="M12 3.5 21 19H3L12 3.5Z"
                      stroke="currentColor" stroke-width="1.8"
                      stroke-linecap="round" stroke-linejoin="round" />
                <path d="M12 9v4.5M12 16.5h.01"
                      stroke="currentColor" stroke-width="2"
                      stroke-linecap="round" />
            </svg>
        </div>

        <span class="maintenance-label">Geçici sistem bakımı</span>
        <h1 id="maintenance-title">Ödeme şu anda tamamlanamıyor</h1>

        <p class="maintenance-description">
            Ödeme sistemimizde kısa süreli bir bakım çalışması yürütüyoruz.
            Hizmetimizi en kısa sürede yeniden aktif hale getireceğiz.
        </p>
        
            <a class="maintenance-button maintenance-button-primary"
               href="/Default/Index">
                Ana sayfaya dön
            </a>


        <p class="maintenance-footnote">
            Anlayışınız için teşekkür ederiz.
        </p>
    </section>
</main>