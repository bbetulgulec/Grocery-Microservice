@model BasketTotalDto
@{
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var subtotal = Model.TotalPrice;
    var tax = subtotal * 0.10m;
    var grandTotal = subtotal + tax;
}

<section class="container my-5">
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="table-responsive basket-table-wrap">
                <table class="table basket-table align-middle">
                    <thead>
                    <tr>
                        <th>@L["Admin_HighlightList_Product"]</th>
                        <th>@L["Price"]</th>
                        <th>@L["amount"]</th>
                        <th>@L["total"]</th>
                        <th>@L["remove"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.BasketItems)
                    {
                        // Ürünün birimine göre artış/azalış miktarını belirliyoruz
                        var step = item.Unit.ToString() == "Kg" ? 0.5m : 1m;
                        var unitLabel = item.Unit.ToString() switch
                        {
                            "Kg" => "Kg",
                            "Pack" => "Paket",
                            _ => "Adet"
                        };

                        <tr>
                            <td class="basket-product-name">
                                @item.ProductName
                            </td>
                            <td>@item.Price ₺</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Azalt Butonu -->
                                    <form asp-action="ChangeCount" asp-controller="Basket" method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId"/>
                                        <input type="hidden" name="changeBy" value="@(-step)"/>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">−</button>
                                    </form>

                                    <!-- Miktar ve Birim Gösterimi (Örn: 1.5 Kg / 2 Adet) -->
                                    <span class="fw-semibold">@item.Quantity @unitLabel</span>

                                    <!-- Artır Butonu -->
                                    <form asp-action="ChangeCount" asp-controller="Basket" method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@item.ProductId"/>
                                        <input type="hidden" name="changeBy" value="@step"/>
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">+</button>
                                    </form>
                                </div>
                            </td>
                            <!-- Toplam Fiyat Hesabı (Çarpma Operatörü Düzeltildi) -->
                            <td>@((item.Price * item.Quantity).ToString("N2")) ₺</td>
                            <td>
                                <form asp-controller="Basket" asp-action="RemoveFromBasket" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@item.ProductId"/>
                                    <button type="submit" class="btn btn-danger btn-sm">×</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="row g-3">
                <div class="col-12">
                    <aside class="gec-card p-4">
                        <h3 class="h4 mb-4">@L["Order_Summary"]</h3>

                        <div class="d-flex justify-content-between mb-3">
                            <span>@L["Total_Product_Price"]</span>
                            <strong>@subtotal.ToString("N2") ₺</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>@L["kdv"]</span>
                            <strong>@tax.ToString("N2") ₺</strong>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between fs-5">
                            <span>@L["total"]</span>
                            <strong>@grandTotal.ToString("N2") ₺</strong>
                        </div>
                    </aside>
                </div>
                <div class="col-12">
                    <aside class="gec-card p-4">
                        <form asp-controller="Basket"
                              asp-action="ContinueToPayment"
                              method="post">
                            <fieldset>
                                <legend class="h4 mb-4">@L["Payment_Method"]</legend>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio"
                                           name="paymentMethod" id="paymentCard"
                                           value="Card" checked>
                                    <label class="form-check-label" for="paymentCard">
                                        @L["Kredi_Bank_Card"]
                                    </label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio"
                                           name="paymentMethod" id="paymentCash"
                                           value="Cash">
                                    <label class="form-check-label" for="paymentCash">@L["Cash"]</label>
                                </div>
                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="radio"
                                           name="paymentMethod" id="paymentPickup"
                                           value="Pickup">
                                    <label class="form-check-label" for="paymentPickup">@L["Pick_Up"]</label>
                                </div>
                            </fieldset>

                            <button type="submit" class="btn-gec-main w-100 mt-4">
                                @L["Continue"]
                            </button>
                        </form>
                    </aside>
                </div>
            </div>
        </div>
    </div>
</section>