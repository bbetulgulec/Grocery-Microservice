@{
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<section class="maintenance-page">
    <div class="maintenance-card" aria-labelledby="order-call-title">
        <div class="maintenance-icon" aria-hidden="true">
            <i class="fa-solid fa-phone-volume"></i>
        </div>

        <span class="maintenance-label">@L["Order_Call_Label"]</span>

        <h1 id="order-call-title">@L["Order_Call_Title"]</h1>

        <p class="maintenance-description">
            @L["Order_Call_Description"]
        </p>

        <div class="maintenance-steps">
            <span><i class="fa-solid fa-location-dot"></i> @L["Order_Call_Step1"]</span>
            <span><i class="fa-solid fa-boxes-stacked"></i> @L["Order_Call_Step2"]</span>
            <span><i class="fa-solid fa-circle-check"></i> @L["Order_Call_Step3"]</span>
        </div>

        <a class="maintenance-button maintenance-button-primary"
           href="tel:+90XXXXXXXXXX">
            <i class="fa-solid fa-phone"></i>
            @L["Order_Call_Button"]
        </a>
    </div>
</section>