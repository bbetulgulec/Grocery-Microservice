@model List<ResultCategoryDtos>
@inject IHttpContextAccessor HttpContextAccessor

@{
    var selectedCategoryIds = HttpContextAccessor.HttpContext?.Request.Query["categoryIds"].ToList() ?? new List<string>();
}

<div class="gec-card mb-4">
    <h5 class="mb-3">@L["Admin_Category_Table"]</h5>
    <div class="d-flex flex-column gap-2">
        @foreach (var item in Model)
        {
            var isChecked = selectedCategoryIds.Contains(item.CategoryID);

            <div class="form-check">
                <input class="form-check-input category-checkbox"
                       type="checkbox"
                       name="categoryId"
                       id="cat-@item.CategoryID"
                       value="@item.CategoryID"
                       @(isChecked ? "checked" : "")>
                <label class="form-check-label" for="cat-@item.CategoryID">
                    @item.CategoryName
                </label>
            </div>
        }
    </div>
</div>