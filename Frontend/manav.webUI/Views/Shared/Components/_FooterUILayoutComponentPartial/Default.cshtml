@model ResultAboutDto

<footer class="site-footer" id="contact">
  <div class="container py-4">
    <div class="row g-4 align-items-start">
      <div class="col-lg-6 col-md-12">
        <a class="footer-brand d-inline-flex align-items-center fs-4 fw-bold text-decoration-none text-white mb-3"
           href="~/">
          <i class="fa-solid fa-leaf brand-mark me-2 text-success" aria-hidden="true"></i>@L["Mevsim_Manav"]
        </a>
        <p class="small text-white-50 lh-lg pe-lg-4 mb-0">
          @Model?.AboutDescription
        </p>
      </div>

      <div class="col-lg-4 col-md-6">
        <h5 class="fw-bold mb-3 text-white">@L["Contact"]</h5>
        <ul class="list-unstyled small text-white-50 mb-0">
          <li class="mb-2 d-flex align-items-start">
            <i class="fa-solid fa-location-dot me-2 mt-1 text-success"></i>
            <span>@Model?.AboutAdress</span>
          </li>
          <li class="mb-2">
            <i class="fa-solid fa-phone me-2 text-success"></i>@Model?.AboutNumber
          </li>
          <li class="mb-2">
            <i class="fa-solid fa-envelope me-2 text-success"></i>@Model?.AboutMail
          </li>
          <li class="mt-3">
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=Mevsim+Manav%C4%B1+Meyve+Sebze+Pazar%C4%B1,+%C4%B0slambey+Cad.+No:4,+34050+Ey%C3%BCpsultan/Amasya"
              target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-light rounded-pill px-3">
              <i class="fa-solid fa-location-arrow me-2"></i>@L["Get_Directions"]
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="col-lg-2 col-md-6">
      <h5 class="fw-bold mb-3 text-white">@L["Admin_About_WorkTime"]</h5>
      <p class="small text-white-50 mb-0">@Model?.AboutWorkTime</p>
    </div>
    
    <hr class="my-4 border-secondary opacity-25">
    <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-2 text-white-50 small">
      <p class="mb-0">&copy; <span id="year"></span> @L["Mevsim_Manav_all_rights_reserved"]</p>
      <div class="payment-icons fs-5 d-flex gap-2">
        <i class="fa-brands fa-cc-visa"></i>
        <i class="fa-brands fa-cc-mastercard"></i>
        <i class="fa-brands fa-cc-paypal"></i>
        <i class="fa-brands fa-cc-apple-pay"></i>
      </div>
    </div>
  </div>
</footer>