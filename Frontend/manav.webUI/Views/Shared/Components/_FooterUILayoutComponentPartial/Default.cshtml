@model ResultAboutDto

<footer class="site-footer" id="contact">
  <div class="container">
    <div class="row g-4">
      <div class="col-lg-4 col-md-6">
        <a class="footer-brand" href="~/favicon.ico">
          <i class="fa-solid fa-leaf brand-mark" aria-hidden="true"></i>@L["Mevsim_Manav"]
        </a>
        <p class="mt-3 mb-3 small">
          @Model?.AboutDescription
        </p>
      </div>

      <div class="col-lg-3 col-md-6">
        <h5>@L["Admin_About_WorkTime"]</h5>
        <p class="small mb-1">@Model?.AboutWorkTime</p>
      </div>
      <div class="col-lg-3 col-md-6">
        <h5>@L["Contact"]</h5>
        <ul>
          <li><i class="fa-solid fa-location-dot me-2"></i>@Model?.AboutAdress</li>
          <li><i class="fa-solid fa-phone me-2"></i>@Model?.AboutNumber</li>
          <li><i class="fa-solid fa-envelope me-2"></i>@Model?.AboutMail</li>
          <li>
            <a
              href="https://www.google.com/maps/dir/?api=1&destination=Mevsim+Manav%C4%B1+Meyve+Sebze+Pazar%C4%B1,+%C4%B0slambey+Cad.+No:4,+34050+Ey%C3%BCpsultan/Amasya"
              target="_blank" rel="noopener noreferrer">
              <i class="fa-solid fa-location-arrow me-2"></i>@L["Get_Directions"]
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
      <p class="mb-0 small">&copy; <span id="year"></span>@L["Mevsim_Manav_all_rights_reserved"]</p>
      <p class="mb-0 small">
        <i class="fa-brands fa-cc-visa me-2"></i><i class="fa-brands fa-cc-mastercard me-2"></i><i
          class="fa-brands fa-cc-paypal me-2"></i><i class="fa-brands fa-cc-apple-pay"></i>
      </p>
    </div>
  </div>
</footer>