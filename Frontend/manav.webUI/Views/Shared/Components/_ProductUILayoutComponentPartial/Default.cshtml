@using manav.webUI.Enums
@model List<ResultProductDto>

<section id="products" class="section">
    <div class="container">
        <div class="section-head is-centered mb-5">
            <span class="eyebrow is-centered"><i
                    class="fa-solid fa-basket-shopping"></i>@L["UI_FeaturedProducts_Eyebrow"]</span>
            <h2 class="mb-2">@L["UI_FeaturedProducts_Heading"]</h2>
            <p class="text-muted-2 mb-0">@L["UI_FeaturedProducts_Description"]</p>
        </div>

        <div class="row g-4">
            @if (Model != null && Model.Any())
            {
                @for (var i = 0; i < Model.Count; i++)
                {
                    var item = Model[i];
                    var badgeType = (i % 4) switch
                    {
                        0 => ProductBadgeType.BestSeller,
                        1 => ProductBadgeType.Trending,
                        2 => ProductBadgeType.OnSale,
                        _ => ProductBadgeType.None
                    };

                    <div class="col-sm-6 col-lg-3">
                        <article class="gec-card product-card">
                            <div class="pc-media">
                                @if (badgeType != ProductBadgeType.None)
                                {
                                    var (badgeText, badgeClass) = badgeType switch
                                    {
                                        ProductBadgeType.BestSeller => (L["UI_FeaturedProducts_BadgeBestSeller"].Value, "is-green"),
                                        ProductBadgeType.Trending => (L["UI_FeaturedProducts_BadgeTrending"].Value, "is-cream"),
                                        ProductBadgeType.OnSale => (L["UI_FeaturedProducts_BadgeOnSale"].Value, "is-green"),
                                        _ => (string.Empty, string.Empty)
                                    };

                                    <span class="pc-tag gh-pill @badgeClass">@badgeText</span>
                                }
                                <img src="@item.ProductImageURL" alt="Product Image" loading="lazy"/>
                            </div>
                        </article>
                    </div>
                }
            }
        </div>

        <div class="text-center mt-5">
            <a href="~/ProductList/Index" class="btn-gec btn-gec-outline">@L["UI_FeaturedProducts_ViewAllButton"] <i
                    class="fa-solid fa-arrow-right-long"></i></a>
        </div>
    </div>
</section>