<section id="menu" class="section menu-section">
  <div class="container">
    <div class="row g-4 g-lg-5">
      <!-- Frozen left panel -->
      <div class="col-lg-4">
        <div class="menu-aside">
          <span class="eyebrow"><i class="fa-solid fa-utensils"></i>@L["UI_HomeSideMenu_Eyebrow"]</span>
          <h2 class="mb-3">@L["UI_HomeSideMenu_Heading"]</h2>
          <p class="text-muted-2 mb-4">
            @L["UI_HomeSideMenu_Description"]
          </p>
          <div class="menu-figure d-none d-lg-block">
            <img src="https://d2gv4t6k9xuh77.cloudfront.net/HomePage/MenuImage/side-menu-image.jpeg"
                 alt="A spread of fresh organic produce on a wooden table" loading="lazy"/>
          </div>
        </div>
      </div>
      <!-- Scrollable right list -->
      @await Component.InvokeAsync("_SideListMenuUILayoutComponentPartial")
    </div>
  </div>
</section>
