<section class="section">
    <div class="container">
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="feature-mini">
                    <span class="fm-ico"><i class="fa-solid fa-medal"></i></span>
                    <div>
                        <h4>@L["UI_HomeFeatures_HighQualityTitle"]</h4>
                        <p>@L["UI_HomeFeatures_HighQualityDesc"]</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="feature-mini">
                    <span class="fm-ico"><i class="fa-solid fa-layer-group"></i></span>
                    <div>
                        <h4>@L["UI_HomeFeatures_WideVarietyTitle"]</h4>
                        <p>@L["UI_HomeFeatures_WideVarietyDesc"]</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="feature-mini">
                    <span class="fm-ico"><i class="fa-solid fa-truck-fast"></i></span>
                    <div>
                        <h4>@L["UI_HomeFeatures_FastDeliveryTitle"]</h4>
                        <p>@L["UI_HomeFeatures_FastDeliveryDesc"]</p>
                    </div>
                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="feature-mini">
                    <span class="fm-ico"><i class="fa-solid fa-tags"></i></span>
                    <div>
                        <h4>@L["UI_HomeFeatures_AffordablePricesTitle"]</h4>
                        <p>@L["UI_HomeFeatures_AffordablePricesDesc"]</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>