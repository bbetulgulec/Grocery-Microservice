         <div class="gec-card mb-4">
                    <h5 class="mb-3">Price Range</h5>
                    <form asp-controller="ProductList" asp-action="Index" method="get" id="priceFilterForm">
                        <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId"/>
                        <div class="d-flex flex-column gap-2">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priceRange" id="price-all" value="" checked onchange="this.form.submit()">
                                <label class="form-check-label" for="price-all">All Prices</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priceRange" id="price-1" value="0-5" onchange="this.form.submit()">
                                <label class="form-check-label" for="price-1">$0 – $5</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priceRange" id="price-2" value="5-10" onchange="this.form.submit()">
                                <label class="form-check-label" for="price-2">$5 – $10</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priceRange" id="price-3" value="10-20" onchange="this.form.submit()">
                                <label class="form-check-label" for="price-3">$10 – $20</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="priceRange" id="price-4" value="20+" onchange="this.form.submit()">
                                <label class="form-check-label" for="price-4">$20+</label>
                            </div>
                        </div>
                    </form>
                </div>