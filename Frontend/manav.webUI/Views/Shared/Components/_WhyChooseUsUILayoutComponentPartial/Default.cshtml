<section id="about" class="section section-alt">
  <div class="container">
    <div class="row g-5 align-items-center">
      <div class="col-lg-6 order-lg-2">
        <div class="choose-figure">
          <img src="https://d2gv4t6k9xuh77.cloudfront.net/HomePage/WhyChooseUsePage/hal.jpeg"
               alt="Organic farmer holding a basket of freshly harvested vegetables" loading="lazy"/>
          <div class="experience-badge">
            <div class="xb-num">@L["UI_WhyChooseUs_ExperienceBadgeNum"]</div>
            <div class="xb-label">@L["UI_WhyChooseUs_ExperienceBadgeLabel"]</div>
          </div>
        </div>
      </div>
      <div class="col-lg-6 order-lg-1">
        <span class="eyebrow"><i class="fa-solid fa-heart"></i>@L["UI_WhyChooseUs_Eyebrow"]</span>
        <h2 class="mb-3">@L["UI_WhyChooseUs_Heading"]</h2>
        <p class="text-muted-2 mb-4">
          @L["UI_WhyChooseUs_Description"]
        </p>
        <div class="row g-4">
          <div class="col-sm-6">
            <div class="choose-feature">
              <span class="cf-ico"><i class="fa-solid fa-leaf"></i></span>
              <div><h4>@L["UI_WhyChooseUs_Feature1_Title"]</h4>
                <p>@L["UI_WhyChooseUs_Feature1_Desc"]</p></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="choose-feature">
              <span class="cf-ico"><i class="fa-solid fa-bowl-food"></i></span>
              <div><h4>@L["UI_WhyChooseUs_Feature2_Title"]</h4>
                <p>@L["UI_WhyChooseUs_Feature2_Desc"]</p></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="choose-feature">
              <span class="cf-ico"><i class="fa-solid fa-heart-pulse"></i></span>
              <div><h4>@L["UI_WhyChooseUs_Feature3_Title"]</h4>
                <p>@L["UI_WhyChooseUs_Feature3_Desc"]</p></div>
            </div>
          </div>
          <div class="col-sm-6">
            <div class="choose-feature">
              <span class="cf-ico"><i class="fa-solid fa-earth-americas"></i></span>
              <div><h4>@L["UI_WhyChooseUs_Feature4_Title"]</h4>
                <p>@L["UI_WhyChooseUs_Feature4_Desc"]</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
