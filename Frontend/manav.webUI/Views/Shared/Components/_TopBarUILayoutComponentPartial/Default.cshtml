@using Microsoft.AspNetCore.Localization
@model ResultUserListDto

@{
  var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "tr-TR";
  var isEnglish = currentCulture.StartsWith("en", StringComparison.OrdinalIgnoreCase);
}

<header class="site-header">
  <nav class="navbar navbar-expand-lg container" aria-label="Primary">
    <a class="navbar-brand" href="/Default/Index/">
      <img src="~/favicon.ico" alt="Mevsim Manav" class="brand-mark">
      @L["Mevsim_Manav"]
    </a>
    <div class="d-flex align-items-center gap-2 order-lg-last ms-lg-3">

      <!-- DİL DEĞİŞTİRİCİ DROPDOWN (YENİ EKLENDİ) -->
      <div class="dropdown">
        <button class="btn btn-sm d-flex align-items-center gap-1 rounded-pill px-3 py-1 fw-bold text-light border-0"
                type="button"
                id="languageDropdown"
                data-bs-toggle="dropdown"
                aria-expanded="false"
                style="background-color: rgba(255, 255, 255, 0.1); font-size: 0.85rem;">
          <i class="fa-solid fa-globe"></i>
          <span>@(isEnglish ? "EN" : "TR")</span>
        </button>
        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="languageDropdown"
            style="min-width: 100px;">
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 @(!isEnglish ? "fw-bold active" : "")"
               href="/Language/Change?culture=tr-TR&returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">
              <span>🇹🇷</span> TR
            </a>
          </li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 @(isEnglish ? "fw-bold active" : "")"
               href="/Language/Change?culture=en-US&returnUrl=@Uri.EscapeDataString(Context.Request.Path + Context.Request.QueryString)">
              <span>🇬🇧</span> EN
            </a>
          </li>
        </ul>
      </div>

      <!-- TEMA DEĞİŞTİRME BUTONU -->
      <button
        class="theme-toggle"
        id="themeToggle"
        type="button"
        aria-label="Toggle light and dark theme"
        title="Toggle light / dark">
        <svg class="icon icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
        <svg class="icon icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>
        </svg>
      </button>

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMain"
              aria-controls="navMain" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
    <div class="collapse navbar-collapse" id="navMain">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#home">@L["Common_Home"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#about">@L["UI_Navbar_About"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#menu">@L["Menü"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#products">@L["Admin_Product_Table"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#gallery">@L["UI_Navbar_Gallery"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#reviews">@L["UI_Navbar_Reviews"]</a></li>
        <li class="nav-item"><a class="nav-link" href="/Default/Index/#contact">@L["UI_Navbar_Contact"]</a></li>
      </ul>
    </div>
    @if (Model != null)
    {
      <div class="dropdown ms-lg-4 d-none d-lg-inline-flex">
        <button class="btn-gec btn-gec-primary dropdown-toggle d-flex align-items-center gap-2"
                type="button"
                id="userMenuButton"
                data-bs-toggle="dropdown"
                aria-expanded="false">
          <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
          <span>@Model.name @Model.surname</span>
        </button>

        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenuButton">
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2" href="/Order/UserOrderList">
              <i class="fa fa-shopping-bag text-muted"></i>
              @L["MyOrders_Title"]
            </a>
          </li>
          <li>
            <a class="dropdown-item d-flex align-items-center gap-2 text-danger" href="/Login/Logout">
              <i class="fa-solid fa-right-from-bracket"></i>
              @L["UI_Navbar_Sing_Out"]
            </a>
          </li>
        </ul>
      </div>
    }
    else
    {
      <a href="/Login/Index"
         class="btn-gec btn-gec-primary ms-lg-4 d-none d-lg-inline-flex">
        <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
        @L["Admin_Login_Title"]
      </a>
    }
  </nav>
</header>