<section class="video-bg-section">
    <video
        class="vbg-media"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="https://d2gv4t6k9xuh77.cloudfront.net/HomePage/AutoPlayPage/Characters_working_in_greengroce%E2%80%A6_kaynag%CC%86%C4%B1ndan_20260912223139.jpeg">
        <source src="https://d2gv4t6k9xuh77.cloudfront.net/HomePage/AutoPlayPage/ai-video.mp4" type="video/mp4"/>
    </video>
    <div class="vbg-overlay" aria-hidden="true"></div>

    <div class="container vbg-inner">
        <div class="row">
            <div class="col-lg-8">
                <span class="eyebrow"><i class="fa-solid fa-tractor"></i>@L["UI_HomeVideo_Eyebrow"]</span>
                <h2>@L["UI_HomeVideo_Heading"]</h2>
                <p>
                    @L["UI_HomeVideo_Description"]
                </p>
                <div class="vbg-stats">
                    <div class="stat">
                        <div class="n">120+</div>
                        <div class="l">@L["UI_HomeVideo_Stat1Label"]</div>
                    </div>
                    <div class="stat">
                        <div class="n">15k</div>
                        <div class="l">@L["UI_HomeVideo_Stat2Label"]</div>
                    </div>
                    <div class="stat">
                        <div class="n">98%</div>
                        <div class="l">@L["UI_HomeVideo_Stat3Label"]</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


