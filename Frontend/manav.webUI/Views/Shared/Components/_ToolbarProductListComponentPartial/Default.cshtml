<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <div class="d-flex gap-2">
        <button type="button" class="btn-gec btn-gec-outline btn-sm view-toggle active" data-view="grid" title="Grid view">
            <i class="fa-solid fa-table-cells-large"></i>
        </button>
        <button type="button" class="btn-gec btn-gec-outline btn-sm view-toggle" data-view="list" title="List view">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="text-muted-2 small">
            @(Model?.Count ?? 0) products
        </span>

        <div class="dropdown">
            <button class="btn-gec btn-gec-outline btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                Sort by
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" href="?sort=latest&categoryId=@ViewBag.SelectedCategoryId">Latest</a></li>
                <li><a class="dropdown-item" href="?sort=price-asc&categoryId=@ViewBag.SelectedCategoryId">Price: Low to High</a></li>
                <li><a class="dropdown-item" href="?sort=price-desc&categoryId=@ViewBag.SelectedCategoryId">Price: High to Low</a></li>
                <li><a class="dropdown-item" href="?sort=rating&categoryId=@ViewBag.SelectedCategoryId">Best Rating</a></li>
            </ul>
        </div>
    </div>
</div>