<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
    <div class="d-flex gap-2">
        <button type="button" class="btn-gec btn-gec-outline btn-sm view-toggle active" data-view="grid"
                title="@L["UI_ProductCatalog_Toolbar_GridViewTitle"]">
            <i class="fa-solid fa-table-cells-large"></i>
        </button>
        <button type="button" class="btn-gec btn-gec-outline btn-sm view-toggle" data-view="list"
                title="@L["UI_ProductCatalog_Toolbar_ListViewTitle"]">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>

    <div class="d-flex align-items-center gap-2">
        <span class="text-muted-2 small">
            @string.Format(L["UI_ProductCatalog_Toolbar_ProductCountFormat"].Value, Model?.Count ?? 0)
        </span>

        <div class="dropdown">
            <button class="btn-gec btn-gec-outline btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown"
                    aria-expanded="false">
                @L["UI_ProductCatalog_Toolbar_SortByButton"]
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item"
                       href="?sort=latest&categoryId=@ViewBag.SelectedCategoryId">@L["UI_ProductCatalog_Toolbar_SortLatest"]</a>
                </li>
                <li><a class="dropdown-item"
                       href="?sort=price-asc&categoryId=@ViewBag.SelectedCategoryId">@L["UI_ProductCatalog_Toolbar_SortPriceAsc"]</a>
                </li>
                <li><a class="dropdown-item"
                       href="?sort=price-desc&categoryId=@ViewBag.SelectedCategoryId">@L["UI_ProductCatalog_Toolbar_SortPriceDesc"]</a>
                </li>
                <li><a class="dropdown-item"
                       href="?sort=rating&categoryId=@ViewBag.SelectedCategoryId">@L["UI_ProductCatalog_Toolbar_SortRating"]</a>
                </li>
            </ul>
        </div>
    </div>
</div>