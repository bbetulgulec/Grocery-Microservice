<section id="home" class="hero-section">
    <div class="hero-bgs" aria-hidden="true">
        <div class="hero-bg is-active"
             style="background-image: url('https://d2gv4t6k9xuh77.cloudfront.net/HomePage/HeroImage/front-of-shop-together.png')"></div>
        <div class="hero-bg"
             style="background-image: url('https://d2gv4t6k9xuh77.cloudfront.net/HomePage/HeroImage/front-of-shop.jpeg')"></div>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="container hero-inner">
        <span class="eyebrow"><i class="fa-solid fa-seedling"></i>@L["UI_HomeHero_Eyebrow"]</span>
        <h1> @L["UI_HomeHero_TitlePrefix"]<span class="hero-rotate" data-words="Sebze|Meyve">@L["Vegetables"]</span>
        </h1>
        <p class="lead">
            @L["UI_HomeHero_Description"]
        </p>
        <div class="d-flex flex-wrap gap-3 hero-bottom-actions">
            <a href="#products" class="btn-gec btn-gec-primary"><i
                    class="fa-solid fa-basket-shopping"></i> @L["Admin_Product_Table"]</a>
            <a href="#about" class="btn-gec btn-gec-cream"><i
                    class="fa-solid fa-circle-info"></i>@L["UI_HomeHero_MoreInfoButton"]</a>
        </div>
    </div>
</section>