@using manav.DtoLayer.BasketDtos
@model BasketTotalDto

<section aria-labelledby="total-title" class="mb-4">
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-header bg-dark text-white p-3">
            <h5 class="card-title mb-0 fs-6 text-uppercase fw-bold text-light">
                <i class="fa-solid fa-receipt me-2"></i>Sipariş Özeti
            </h5>
        </div>

        <div class="card-body p-4">
            <h6 class="fw-bold mb-3 text-secondary border-bottom pb-2">Ürünler</h6>

            <div class="basket-item-list" style="max-height: 260px; overflow-y: auto;">
                @if (Model != null && Model.BasketItems != null && Model.BasketItems.Any())
                {
                    @foreach (var item in Model.BasketItems)
                    {
                        <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                            <div class="d-flex align-items-center">
                                <span class="badge bg-secondary rounded-pill me-2">@item.Quantity x</span>
                                <span class="fw-medium text-white text-truncate" style="max-width: 160px;">
                                    @(string.IsNullOrEmpty(item.ProductName) ? "Ürün" : item.ProductName)
                                </span>
                            </div>
                            <span class="fw-semibold text-white">@((item.Price * item.Quantity).ToString("C2"))</span>
                        </div>
                    }
                }
                else
                {
                    <div class="alert alert-warning text-center small my-2">
                        Sepetinizde ürün bulunmamaktadır.
                    </div>
                }
            </div>

            <div class="mt-3 pt-2">
                <div class="d-flex justify-content-between py-2 text-muted">
                    <span>Ara Toplam</span>
                    <span class="fw-semibold text-white">@(Model?.TotalPrice.ToString("C2") ?? "₺0,00")</span>
                </div>

                @{
                    decimal shippingPrice = (Model != null && Model.TotalPrice > 0) ? 29.90m : 0m;
                    decimal grandTotal = (Model?.TotalPrice ?? 0) + shippingPrice;
                }

                <div class="d-flex justify-content-between py-2 text-muted">
                    <span>Kargo Ücreti</span>
                    <span class="fw-semibold text-white">
                        @(shippingPrice > 0 ? shippingPrice.ToString("C2") : "Ücretsiz")
                    </span>
                </div>

                <hr class="my-2" />

                <div class="d-flex justify-content-between pt-2 mb-4 align-items-center">
                    <span class="fs-6 fw-bold text-white">Ödenecek Tutar</span>
                    <span class="fs-4 fw-bolder text-success">@grandTotal.ToString("C2")</span>
                </div>

                <form action="/Order/CreateOrder" method="post">
                    <button type="submit" class="btn btn-success w-100 py-2 fw-bold text-uppercase shadow-sm">
                        <i class="fa-solid fa-credit-card me-2"></i> Siparişi Tamamla
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>