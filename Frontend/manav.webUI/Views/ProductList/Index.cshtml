@{
    ViewBag.Title = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}


<section id="products" class="section">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-3">
                @await Component.InvokeAsync("_FilterProductListComponentPartial")
            </div>
            <div class="col-lg-9">
                <!-- Toolbar: view toggle + sort + count -->
                @await Component.InvokeAsync("_ToolbarProductListComponentPartial")
                <!-- Grid -->
                <div id="productListContainer">
                    @await Component.InvokeAsync("_ProductsProductListComponentPartial")
                </div>                <!-- Pagination -->
                @await Component.InvokeAsync("_PaginationProductListComponentPartial")

            </div>

        </div>
    </div>
</section>
<script>
    document.addEventListener('click', function (e) {
        if (e.target && e.target.id === 'btnApplyFilter') {
            e.preventDefault();
            const checkedInputs = document.querySelectorAll('.category-checkbox:checked');
            const selectedCategoryIds = Array.from(checkedInputs).map(cb => cb.value);
            const params = new URLSearchParams();
            selectedCategoryIds.forEach(id => params.append('categoryIds', id));

            fetch(`/ProductList/GetProductsByCategory?${params.toString()}`)
                .then(response => {
                    if (!response.ok) throw new Error('Hata oluştu.');
                    return response.text();
                })
                .then(html => {
                    const container = document.getElementById('productListContainer');
                    if (container) {
                        container.innerHTML = html;
                    }
                })
                .catch(error => {
                    console.error('Hata:', error);
                    alert('Filtreleme yapılırken bir hata oluştu.');
                });
        }
    });
</script>
}
