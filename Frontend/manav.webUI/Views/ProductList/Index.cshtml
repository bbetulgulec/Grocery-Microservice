@{
    ViewBag.Title = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}


@model List<ResultProductWithCategoryDto>
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}

<section id="products" class="section">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-3">
                @await Component.InvokeAsync("_FilterProductListComponentPartial")
            </div>
            <div class="col-lg-9">
                <!-- Grid -->
                <div id="productListContainer">
                    <!-- Model üzerinden gelen filtrelenmiş listeyi buraya veriyoruz -->
                    @await Component.InvokeAsync("_ProductsProductListComponentPartial", new { products = Model })
                </div>

                <!-- Pagination -->
                @await Component.InvokeAsync(
                    "_PaginationProductListComponentPartial",
                    new
                    {
                        currentPage = (int)ViewBag.CurrentPage,
                        totalPages = (int)ViewBag.TotalPages,
                        categoryIds = (List<string>)ViewBag.SelectedCategoryIds
                    })
            </div>
        </div>
    </div>
</section>
<script>
    document.addEventListener('click', function (e) {
        const button = e.target.closest('#btnApplyFilter');

        if (!button) return;

        e.preventDefault();

        const checkedInputs =
            document.querySelectorAll('.category-checkbox:checked');

        const params = new URLSearchParams();

        checkedInputs.forEach(cb => {
            params.append('categoryIds', cb.value);
        });

        params.set('page', '1');

        window.location.href =
            `/ProductList/Index?${params.toString()}`;
    });
</script>
}
