@{
    Layout = "~/Views/UILayout/_UILayout.cshtml";
    var requestId = Context.TraceIdentifier;
}

<section class="maintenance-page">
    <div class="maintenance-card" role="alert" aria-labelledby="error-title">
        <div class="maintenance-icon" aria-hidden="true">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <span class="maintenance-label">@L["Error_Label"]</span>

        <h1 id="error-title">@L["Error_Title"]</h1>

        <p class="maintenance-description">
            @L["Error_Description"]
        </p>

        <a class="maintenance-button maintenance-button-primary"
           href="/Default/Index">
            <i class="fa-solid fa-house"></i>
            @L["Error_HomeButton"]
        </a>

        <p class="mt-4 mb-0 small text-muted">
            @L["Error_SupportCode"] @requestId
        </p>
    </div>
</section>