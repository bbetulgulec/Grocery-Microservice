@model UpdateProductDto
@{
    ViewBag.Title = Model?.ProductName ?? "Ürün Detayı";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}
<div class="container py-5">
    <!-- Ürün Detay Ana Kartı -->
    <div class="gec-card p-4 p-md-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="gec-media rounded-4 overflow-hidden position-relative">
                    <img src="@Model.ProductImageURL" 
                         class="d-block w-100 object-fit-cover" 
                         style="max-height: 420px; background-color: var(--gec-bg-alt);" 
                         alt="@Model.ProductName">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="ps-lg-3">
                    <h1 class="h2 fw-bold mb-2">@Model.ProductName</h1>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="gh-stars">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                        </div>
                        <span class="text-muted-2 fs-7">(128 değerlendirme)</span>
                    </div>
                    <div class="h3 fw-bold mb-3" style="color: var(--gec-accent);">
                        ₺@Model.ProductPrice <span class="fs-6 text-muted-2 fw-normal">/ @Model.ProductStok kg stok</span>
                    </div>
                    <p class="text-muted-2 mb-4">
                        @Model.ProductDescription
                    </p>
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="fw-semibold" style="min-width: 80px;">Gramaj:</span>
                        <div class="d-flex gap-3 flex-wrap align-items-center">
                            <div class="form-check">
                                <input class="form-check-input weight-radio" type="radio" name="weightOption" id="w1" value="500" checked>
                                <label class="form-check-label ms-1" for="w1">500 Gr</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input weight-radio" type="radio" name="weightOption" id="w2" value="1000">
                                <label class="form-check-label ms-1" for="w2">1 Kg</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input weight-radio" type="radio" name="weightOption" id="w3" value="2000">
                                <label class="form-check-label ms-1" for="w3">2 Kg</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input weight-radio" type="radio" name="weightOption" id="wCustomRadio" value="custom">
                                <label class="form-check-label ms-1" for="wCustomRadio">Başka</label>
                            </div>
                            <div id="customWeightWrapper" class="ms-2" style="display: none;">
                                <div class="input-group input-group-sm" style="width: 140px;">
                                    <input type="number" id="customWeightInput" class="form-control" placeholder="Örn: 750" min="100" step="50">
                                    <span class="input-group-text">Gr</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Miktar & Sepet -->
                    <form asp-controller="Basket"
                          asp-action="AddToBasket"
                          method="post"
                          class="d-flex align-items-center gap-3 my-4">
                        <input type="hidden" name="productId" value="@Model.ProductID" />

                        <button type="submit"
                                class="btn btn-gec-cream px-4 py-2 d-inline-flex align-items-center gap-2">
                            <i class="fa-solid fa-cart-shopping"></i>
                            Sepete Ekle
                        </button>
                    </form>
                    <!-- Sosyal Paylaşım -->
                    <div class="d-flex align-items-center gap-3 pt-3 border-top" style="border-color: var(--gec-border) !important;">
                        <span class="text-muted-2 fw-semibold">Paylaş:</span>
                        <div class="d-flex gap-3">
                            <a href="#" class="text-muted-2 hover-accent"><i class="fa-brands fa-facebook-f"></i></a>
                            <a href="#" class="text-muted-2 hover-accent"><i class="fa-brands fa-x-twitter"></i></a>
                            <a href="#" class="text-muted-2 hover-accent"><i class="fa-brands fa-linkedin-in"></i></a>
                            <a href="#" class="text-muted-2 hover-accent"><i class="fa-brands fa-pinterest"></i></a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll('.weight-radio');
        const customWrapper = document.getElementById('customWeightWrapper');
        const customInput = document.getElementById('customWeightInput');

        radios.forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.id === 'wCustomRadio') {
                    customWrapper.style.display = 'block'; // Kutuyu göster
                    customInput.focus(); // İmleci kutuya odakla
                } else {
                    customWrapper.style.display = 'none'; // Kutuyu gizle
                    customInput.value = ''; // İçeriği temizle
                }
            });
        });
    });
</script>
