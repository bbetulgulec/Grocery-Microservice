@model UpdateProductDto
@{
    ViewBag.Title = Model?.ProductName ?? "Ürün Detayı";
    Layout = "~/Views/UILayout/_UILayout.cshtml";
}
<div class="container py-5">
    <!-- Ürün Detay Ana Kartı -->
    <div class="gec-card p-4 p-md-5">
        <div class="row g-4 align-items-center">
            <div class="col-lg-6">
                <div class="gec-media rounded-4 overflow-hidden position-relative">
                    <img src="@Model.ProductImageURL"
                         class="d-block w-100 object-fit-cover"
                         style="max-height: 420px; background-color: var(--gec-bg-alt);"
                         alt="@Model.ProductName">
                </div>
            </div>
            <div class="col-lg-6">
                <div class="ps-lg-3">
                    <h1 class="h2 fw-bold mb-2">@Model.ProductName</h1>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="gh-stars">
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star"></i>
                            <i class="fa-solid fa-star-half-stroke"></i>
                        </div>
                    </div>
                    <div class="h3 fw-bold mb-3" style="color: var(--gec-accent);">
                        ₺@Model.ProductPrice <span
                            class="fs-6 text-muted-2 fw-normal">/ @Model.ProductStok @L["UI_ProductDetail_StockSuffix"]</span>
                    </div>
                    <p class="text-muted-2 mb-4">
                        @Model.ProductDescription
                    </p>
                    <!-- DİNAMİK BİRİM / MİKTAR SEÇENEKLERİ -->
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="fw-semibold" style="min-width: 80px;">Miktar:</span>
                        <div class="d-flex gap-3 flex-wrap align-items-center">

                            @if (Model.Unit.ToString() == "Kg")
                            {
                                <!-- Kiloluk Ürünler İçin -->
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="w1" value="500" checked>
                                    <label class="form-check-label ms-1" for="w1">500 Gr</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="w2" value="1000">
                                    <label class="form-check-label ms-1" for="w2">1 Kg</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="w3" value="2000">
                                    <label class="form-check-label ms-1" for="w3">2 Kg</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="customRadio" value="custom">
                                    <label class="form-check-label ms-1" for="customRadio">Başka</label>
                                </div>
                                <div id="customQuantityWrapper" class="ms-2" style="display: none;">
                                    <div class="input-group input-group-sm" style="width: 140px;">
                                        <input type="number" id="customQuantityInput" class="form-control"
                                               placeholder="Örn: 750" min="100" step="50">
                                        <span class="input-group-text">Gr</span>
                                    </div>
                                </div>
                            }
                            else if (Model.Unit.ToString() == "Pack")
                            {
                                <!-- Paket Ürünler İçin -->
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="p1" value="1" checked>
                                    <label class="form-check-label ms-1" for="p1">1 Paket</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="p2" value="2">
                                    <label class="form-check-label ms-1" for="p2">2 Paket</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="p3" value="3">
                                    <label class="form-check-label ms-1" for="p3">3 Paket</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="customRadio" value="custom">
                                    <label class="form-check-label ms-1" for="customRadio">Başka</label>
                                </div>
                                <div id="customQuantityWrapper" class="ms-2" style="display: none;">
                                    <div class="input-group input-group-sm" style="width: 140px;">
                                        <input type="number" id="customQuantityInput" class="form-control"
                                               placeholder="Örn: 5" min="1" step="1">
                                        <span class="input-group-text">Paket</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Adet Ürünler İçin -->
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="a1" value="1" checked>
                                    <label class="form-check-label ms-1" for="a1">1 Adet</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="a2" value="2">
                                    <label class="form-check-label ms-1" for="a2">2 Adet</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="a3" value="3">
                                    <label class="form-check-label ms-1" for="a3">3 Adet</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input quantity-radio" type="radio" name="quantityOption"
                                           id="customRadio" value="custom">
                                    <label class="form-check-label ms-1" for="customRadio">Başka</label>
                                </div>
                                <div id="customQuantityWrapper" class="ms-2" style="display: none;">
                                    <div class="input-group input-group-sm" style="width: 140px;">
                                        <input type="number" id="customQuantityInput" class="form-control"
                                               placeholder="Örn: 10" min="1" step="1">
                                        <span class="input-group-text">Adet</span>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                    <form asp-controller="Basket"
                          asp-action="AddToBasket"
                          method="post"
                          class="d-flex align-items-center gap-3 my-4">
                        <input type="hidden" name="productId" value="@Model.ProductID"/>

                        <button type="submit"
                                class="btn btn-gec-cream px-4 py-2 d-inline-flex align-items-center gap-2">
                            <i class="fa-solid fa-cart-shopping"></i>
                            Sepete Ekle
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const radios = document.querySelectorAll('.quantity-radio');
        const customWrapper = document.getElementById('customQuantityWrapper');
        const customInput = document.getElementById('customQuantityInput');

        if (radios.length > 0 && customWrapper) {
            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    if (this.id === 'customRadio') {
                        customWrapper.style.display = 'block';
                        customInput.focus();
                    } else {
                        customWrapper.style.display = 'none';
                        customInput.value = '';
                    }
                });
            });
        }
    });
</script>
