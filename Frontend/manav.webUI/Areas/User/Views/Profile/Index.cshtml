@{
  Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<!-- Head Partial -->
@await Component.InvokeAsync("_UserLayoutHeadViewComponentPartial")
<body>
<div class="container-scroller d-flex">
  <!-- Sidebar Partial-->
  @await Component.InvokeAsync("_UserLayoutSidebarComponentPartial")
  <div class="container-fluid page-body-wrapper">
    <!-- Navbar Partial -->
    @await Component.InvokeAsync("_UserNavbarViewComponentPartial")
    <!-- partial -->
    <div class="main-panel">
      <div class="content-wrapper">
        <div class="row">
          @RenderBody()
        </div>
      </div>
      <!-- Footer Partial -->
      @await Component.InvokeAsync("_UserFooterViewComponentPartial")
    </div>
  </div>
</div>
<!-- Script Partial -->
@await Component.InvokeAsync("_UserScriptViewComponentPartial")
</body>

</html>
