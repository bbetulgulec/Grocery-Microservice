@model List<ResultSendboxMessageDto>
@{
    Layout = "~/Areas/User/Views/Profile/Index.cshtml";
    var count = 0;
    
}
<div class="main-panel">
    <div class="content-wrapper">
        <div class="row">
            <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                    <div class="card-body">
                        <h4 class="card-title">Gelen Mesaj Listesi</h4>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Alıcı</th>
                                    <th>Konu</th>
                                    <th>Tarih </th>
                                    <th>Durum</th>
                                    <th>Sil </th>
                                    <th>Mesajı aç </th>

                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <th>@count</th>
                                        <td>@item.ReceiverId</td>
                                        <td>@item.Subject</td>
                                        <td>@item.MessegeDate</td>
                                        <td>@item.IsRead</td>
                                        <td><a href="#" class="badge badge-danger">sil</a></td>
                                        <td><a href="#" class="badge badge-warning">mesajı aç </a></td>
                                    </tr>           
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Footer Partial -->
    @await Component.InvokeAsync("_UserFooterViewComponentPartial")
</div>

