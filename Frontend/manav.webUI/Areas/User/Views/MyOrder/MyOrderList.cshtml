@model List<ResultOrderingByUserIdDto>
@{
  ViewBag.Title = "Main";
  Layout = "~/Areas/User/Views/Profile/Index.cshtml";
  var count = 0;
}
<div class="main-panel">
      <div class="content-wrapper">
        <div class="row">
          <div class="col-lg-12 grid-margin stretch-card">
            <div class="card">
              <div class="card-body">
                <h4 class="card-title">Basic Table</h4>
                <p class="card-description">
                  Add class <code>.table</code>
                </p>
                <div class="table-responsive">
                  <table class="table">
                    <thead>
                    <tr>
                      <th>#</th>
                      <th>Toplam Fiyat</th>
                      <th>Sipariş Tarihi</th>
                      <th>Sipariş Detayları </th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                      <tr>
                        <td>@(++count)</td>
                        <td>@item.TotalPrice</td>
                        <td>@item.OrderDate</td>
                        <td><a href="#" class="badge badge-danger">Detayları</a></td>
                      </tr>           
                    }
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
      <!-- Footer Partial -->
      @await Component.InvokeAsync("_UserFooterViewComponentPartial")
</div>
