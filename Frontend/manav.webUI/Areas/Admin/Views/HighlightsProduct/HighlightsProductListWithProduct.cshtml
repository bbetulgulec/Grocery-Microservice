@model List<ResultHighlightsProductWithProductDto>
@{
    ViewBag.Title = L["Admin_HighlightsProduct_TableList"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_HighlightList_Product"] </th>
                        <th>@L["Admin_HighlightList_ProductName"]</th>
                        <th>@L["Admin_HighlightList_ProductDescription"]</th>
                        <th>@L["Admin_HighlightList_ProductPrice"]</th>
                        <th>@L["Admin_HighlightList_ProductImage"]</th>
                        <th>@L["Delete"]</th>
                        <th>@L["Update"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.Product.ProductName</td>
                            <td>@item.HighlightsProductsName</td>
                            <td>@item.Product.ProductDescription</td>
                            <td>@item.Product.ProductPrice</td>
                            <td>
                                <img src="@item.Product.ProductImageURL"
                                     alt="@item.Product.ProductName"
                                     class="highlight-product-image"/>
                            </td>
                            <td><a href='/Admin/HighlightsProduct/DeleteHighlightsProduct/@item.HighlightsProductsID'
                                   class="btn btn-danger"> @L["Delete"]</a></td>
                            <td><a href='/Admin/HighlightsProduct/UpdateHighlightsProduct/@item.HighlightsProductsID'
                                   class="btn btn-success"> @L["Update"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/HighlightsProduct/CreateHighlightsProduct/" class="btn btn-success btn-top-space"> Yeni
                    @L["Admin_HighlightList_AddNewButton"] </a>
            </div>
        </div>
    </div>
</section>
