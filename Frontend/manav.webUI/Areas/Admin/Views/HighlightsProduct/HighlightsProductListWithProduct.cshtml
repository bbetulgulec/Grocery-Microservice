@model List<ResultHighlightsProductWithProductDto>
@{
    ViewBag.Title = "Highlight Product List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered" >
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Ürün </th>
                        <th>Ürün Adı</th>
                        <th>Ürün Açıklaması</th>
                        <th>Ürün Fiyatı</th>
                        <th>Ürün Resmi</th>
                        <th>Sil</th>
                        <th>Güncelle</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.Product.ProductName</td>
                            <td>@item.HighlightsProductsName</td>
                            <td>@item.Product.ProductDescription</td>
                            <td>@item.Product.ProductPrice</td>
                                <td>
                                <img src="@item.Product.ProductImageURL"
                                     alt="@item.Product.ProductName"
                                     class="highlight-product-image" />
                                </td>
                            <td><a href='/Admin/HighlightsProduct/DeleteHighlightsProduct/@item.HighlightsProductsID' class="btn btn-danger"> Sil</a></td>
                            <td><a href='/Admin/HighlightsProduct/UpdateHighlightsProduct/@item.HighlightsProductsID' class="btn btn-success"> Güncelle</a></td>
                            </tr>
                    }
                    </tbody>
                    </table>
                <a href='/Admin/HighlightsProduct/CreateHighlightsProduct/' class="btn btn-success btn-top-space" > Yeni Ürün girişi </a>
                </div>
        </div>
    </div>
</section>
