@model List<ResultHighlightsProductDto>
@{
    ViewBag.Title = "Highlight Products";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Kategori Adı</th>
                        <th>Sil</th>
                        <th>Güncelle</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.HighlightsProductsName</td>
                            <td><a href='/Admin/HighlightsProduct/DeleteHighlightsProduct/@item.HighlightsProductsID'
                                   class="btn btn-danger"> Sil</a></td>
                            <td><a href='/Admin/HighlightsProduct/UpdateHighlightsProduct/@item.HighlightsProductsID'
                                   class="btn btn-success"> Güncelle</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/HighlightsProduct/CreateHighlightsProduct/" class="btn btn-success btn-top-space"> Yeni
                    öne çıkarılan girişi </a>
            </div>
        </div>
    </div>
</section> 
