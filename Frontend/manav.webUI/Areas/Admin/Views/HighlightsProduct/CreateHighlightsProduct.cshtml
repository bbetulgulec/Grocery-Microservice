@model CreateHighlightsProductDto
@{
    ViewBag.Title = "Create Highlight Product";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Öne Çıkarılan Ürün Ekleme Sayfası</h4>
                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.ErrorMessage
                    </div>
                }
                <br/>
                <div class="bs-example">
                    <form method="post" asp-action="CreateHighlightsProduct" asp-controller="HighlightsProduct" asp-area="Admin" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Öne Çıkarılacak Ürünü Seçin</label>
                            <select asp-for="Product.ProductID" asp-items="@((List<SelectListItem>)ViewBag.ProductList)" class="form-control" required>
                                <option value="">--- Ürün Seçiniz ---</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Seçilen Ürün Fiyatı (Otomatik)</label>
                            <input type="text" asp-for="Product.ProductPrice" class="form-control" readonly placeholder="Ürün seçilince gelecek..." />
                        </div>
                        <div class="form-group" id="productImageDiv" style="display: none;">
                            <label>Seçilen Ürün Görseli (Otomatik)</label>
                            <img src=""
                                 id="productImagePreview"
                                 alt=""
                                 class="highlight-product-image" />
                        </div>
                        <div class="form-group">
                            <label>Öne Çıkan Başlığı (Vitrin Sloganı)</label>
                            <input type="text" class="form-control" asp-for="HighlightsProductsName" placeholder="Örn: Günün Fırsatı!" required />
                        </div>
                        <div class="form-group">
                            <label>Öne Çıkan Açıklaması</label>
                            <input type="text" asp-for="Product.ProductDescription" class="form-control" readonly placeholder="Ürün seçilince gelecek..." />
                        </div>
                        <input type="hidden" id="Product_ProductImageURL" asp-for="Product.ProductImageURL" />
                        <input type="hidden" id="Product_ProductName" asp-for="Product.ProductName" />
                        <input type="hidden" id="Product_CategoryID" asp-for="Product.CategoryID" />
                        <button type="submit" class="btn btn-primary btn-top-space">Öne Çıkarılanı Ekle</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
document.addEventListener("DOMContentLoaded", function () {
    var productSelect = document.getElementById("Product_ProductID");

    function fetchProductDetails() {
        var productId = productSelect.value;
        var imageDiv = document.getElementById("productImageDiv");
        var imgPreview = document.getElementById("productImagePreview");

        // Ürün seçilmediyse tüm alanları ve resmi temizle/gizle
        if (!productId) {
            document.getElementById("Product_ProductPrice").value = "";
            document.getElementById("Product_ProductImageURL").value = "";
            document.getElementById("Product_ProductDescription").value = "";
            document.getElementById("Product_ProductName").value = "";
            document.getElementById("Product_CategoryID").value = "";
            
            imgPreview.src = "";
            imageDiv.style.display = "none";
            return;
        }

        fetch("/Admin/HighlightsProduct/GetProductDetailForHighlight?id=" + productId)
            .then(response => {
                if (!response.ok) {
                    throw new Error("API yanıt vermedi");
                }
                return response.json();
            })
            .then(data => {
                var price = data.productPrice ?? data.ProductPrice ?? data.price ?? 0;
                var image = data.productImageURL ?? data.ProductImageURL ?? data.productImageUrl ?? "";
                var description = data.productDescription ?? data.ProductDescription ?? data.description ?? "";
                var name = data.productName ?? data.ProductName ?? "";
                var categoryId = data.categoryID ?? data.CategoryID ?? data.categoryId ?? "";
                
                document.getElementById("Product_ProductPrice").value = price;
                document.getElementById("Product_ProductImageURL").value = image;
                document.getElementById("Product_ProductDescription").value = description;
                document.getElementById("Product_ProductName").value = name;
                document.getElementById("Product_CategoryID").value = categoryId;

                if (image) {
                    imgPreview.src = image;
                    imageDiv.style.display = "block"; // Görsel varsa div'i göster
                } else {
                    imgPreview.src = "";
                    imageDiv.style.display = "none"; // Görsel yoksa gizle
                }
            })
            .catch(err => {
                console.error("Hata:", err);
                imageDiv.style.display = "none";
            });
    }

    productSelect.addEventListener("change", fetchProductDetails);

    if (productSelect.value) {
        fetchProductDetails();
    }
});
</script>