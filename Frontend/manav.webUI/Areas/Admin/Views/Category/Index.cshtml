@model List<ResultCategoryDtos>
@{
    ViewBag.Title = "Kategori Listesi";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_Category_Name"]</th>
                        <th>@L["Delete"]</th>
                        <th>@L["Update"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.CategoryName</td>
                            <td><a href='/Admin/Category/DeleteCategory/@item.CategoryID' class="btn btn-danger">
                                    @L["Delete"]</a></td>
                            <td><a href='/Admin/Category/UpdateCategory/@item.CategoryID' class="btn btn-success">
                                    @L["Update"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/Category/CreateCategory/"
                   class="btn btn-success btn-top-space">@L["Admin_Category_CreateButton"]</a>
            </div>
        </div>
    </div>
</section> 