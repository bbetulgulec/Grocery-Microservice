@model List<ResultGalleryDto>
@{
    ViewBag.Title = "Gallery Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>Resim Adı</th>
                        <th>Resim</th>
                        <th>Sil</th>
                        <th>Güncelle</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.GallaryName</td>
                            <td>
                                <img src="@item.GalleryUrl"
                                     alt="@item.GallaryName"
                                     class="highlight-product-image"/>
                            </td>
                            <td><a href='/Admin/Gallery/DeleteGallery/@item.GallaryId' class="btn btn-danger"> Sil</a>
                            </td>
                            <td><a href='/Admin/Gallery/UpdateGallery/@item.GallaryId' class="btn btn-success">
                                    Güncelle</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/Gallery/CreateGallery/" class="btn btn-success"> Yeni Kategori girişi </a>
            </div>
        </div>
    </div>
</section>
