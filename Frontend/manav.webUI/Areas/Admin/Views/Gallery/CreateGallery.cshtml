@model CreateGalleryDto
@{
    ViewBag.Title = "Create Gallery";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid" xmlns="http://www.w3.org/1999/html">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>@L["Admin_Gallery_CreateTitle"]</h4>
                <br/>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>@L["Admin_Gallery_Name"]</label>
                            <input type="text" class="form-control" asp-for="GallaryName"/>
                        </div>
                        <div class="form-group">
                            <label>@L["Admin_Gallery_Image"]</label>
                            <input type="file" class="form-control" asp-for="ImageFile" accept="image/*"/>
                        </div>
                        <button class="btn btn-primary ">@L["Admin_Gallery_CreateButton"]</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section> 

