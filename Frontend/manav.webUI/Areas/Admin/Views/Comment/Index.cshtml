@model List<ResultCommentDto>
@{
    ViewData["Title"] = L["Admin_Comment_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="action-button-area">
                <a href="/Admin/Comment/FetchGoogleReviews" class="btn btn-primary">
                    <i class="fa fa-google"></i>@L["Admin_Comment_SyncGoogle"]
                </a>
            </div>
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_Comment_FirstName"]</th>
                        <th>@L["Admin_Comment_LastName"]</th>
                        <th>@L["Admin_Comment_UserImage"]</th>
                        <th>@L["Admin_Comment_CommentDetail"]</th>
                        <th>@L["Admin_Comment_Rating"]</th>
                        <th>@L["Admin_Comment_CreatedDate"]</th>
                        <th>@L["Admin_Comment_IsAddedGoogle"]</th>
                        <th>@L["Admin_Comment_PublishStatus"]</th>
                        <th>@L["Delete"]</th>
                        <th>@L["Admin_Comment_Status"]</th>

                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td class="text-center">
                                @if (!string.IsNullOrEmpty(item.UserImageURL))
                                {
                                    <img src="@item.UserImageURL" alt="@item.FirstName" class="user-avatar"/>
                                }
                                else
                                {
                                    <i class="fa fa-user default-user-icon" aria-hidden="true"></i>
                                }
                            </td>
                            <td>@item.CommentDetail</td>
                            <td>@item.Rating</td>
                            <td>@item.CreatedDate</td>
                            <td>@item.isAddedGoogle</td>
                            <td>
                                @if (item.status)
                                {
                                    <span class="label label-success">@L["Admin_Comment_Active"]</span>
                                }
                                else
                                {
                                    <span class="label label-default">@L["Admin_Comment_Passive"]</span>
                                }
                            </td>
                            <td><a href='/Admin/Comment/DeleteComment/@item.UserCommentId'
                                   class="btn btn-danger">@L["Delete"]</a></td>
                            <td>
                                @if (item.status)
                                {
                                    <a href='/Admin/Comment/ChangeCommentStatus/@item.UserCommentId'
                                       class="btn btn-warning">@L["Admin_Comment_MakePassive"]</a>
                                }
                                else
                                {
                                    <a href='/Admin/Comment/ChangeCommentStatus/@item.UserCommentId'
                                       class="btn btn-success">@L["Admin_Comment_MakeActive"]</a>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section> 