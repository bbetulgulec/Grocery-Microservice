<!DOCTYPE html>
<html lang="en">
@await Component.InvokeAsync("_AdminLayoutHeadViewComponentPartial")
<body class="sidebar-mini">
<div class="wrapper">
    <!-- Main Header -->
    @await Component.InvokeAsync("_AdminLayoutHeaderViewComponentPartial")
    <!-- Left side column. contains the logo and sidebar -->
    @await Component.InvokeAsync("_AdminLayoutSideBarViewComponentPartial")
    <!-- Content Wrapper. Contains page content -->
    <div class="content-wrapper">
        <!-- Content Header (Page header) -->
        @await Component.InvokeAsync("_AdminLayoutMainSectionViewBagComponentPartial")
        <!-- Main content -->
        @RenderBody()
    </div>
</div>
@await Component.InvokeAsync("_AdminLayoutFooterViewComponentPartial")
</body>
</html>