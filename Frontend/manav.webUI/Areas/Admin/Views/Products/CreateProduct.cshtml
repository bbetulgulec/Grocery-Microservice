@model CreateProductDto
@{
    ViewBag.title = "CreateProduct";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid" xmlns="http://www.w3.org/1999/html">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>Ürün Ekleme Sayfası</h4>
                <br/>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post" enctype="multipart/form-data">
                        <div class="form-group">
                            <label>Ürün Adı</label>
                            <input type="text" class="form-control" asp-for="ProductName"/>
                        </div>

                        <div class="form-group">
                            <label>Ürün Fiyatı</label>
                            <input type="text" class="form-control" asp-for="ProductPrice"/>
                        </div>

                        <div class="form-group">
                            <label>Ürün Stoğu</label>
                            <input type="text" class="form-control" asp-for="ProductStok"/>
                        </div>

                        <div class="form-group">
                            <label>Ürün Kategorisi</label>
                            @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.categoryValues, new { @class = "form-control" })
                        </div>

                        <div class="form-group">
                            <label>Ürün Açıklaması</label>
                            <textarea class="form-control" rows="5" asp-for="ProductDescription"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Ürün Resmi</label>
                            <input type="file" class="form-control" asp-for="ImageFile" accept="image/*"/>
                        </div>

                        <div class="form-group m-top-2">
                            <button class="btn btn-primary">Ürünü Ekle</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section> 

