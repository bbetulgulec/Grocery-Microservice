@model UpdateProductDto
@{
    ViewBag.Title = L["Admin_ProductUpdate_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="content container-fluid" xmlns="http://www.w3.org/1999/html">
    <div class="row">
        <div class="col-md-12">
            <div class="chart-box">
                <h4>@L["Admin_ProductUpdate_Title"]</h4>
                <br/>
                <div class="bs-example" data-example-id="bordered-table">
                    <form method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="ProductID"/>
                        <div class="form-group">
                            <label>@L["Admin_HighlightList_ProductName"]</label>
                            <input type="text" class="form-control" asp-for="ProductName"/>

                        </div>
                        <div class="form-group">
                            <label>@L["Admin_HighlightList_ProductPrice"]</label>
                            <input type="number" step="0.01" class="form-control" asp-for="ProductPrice"/>
                        </div>
                        <div class="form-group">
                            <label>@L["Admin_ProductCreate_Stock"]</label>
                            <input type="text" class="form-control" asp-for="ProductStok"/>

                        </div>

                        <div class="form-group">
                            <label>Satış birimi</label>
                            <select asp-for="Unit" class="form-control">
                                <option value="Piece">Adet</option>
                                <option value="Kg">Kilo (kg)</option>
                                <option value="Pack">Paket</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>@L["Admin_ProductCreate_Category"]</label>
                            @Html.DropDownListFor(x => x.CategoryID, (List<SelectListItem>)ViewBag.categoryValues, new { @class = "form-control" })

                        </div>
                        <div class="form-group">
                            <label>@L["Admin_HighlightList_ProductDescription"]</label>
                            <textarea class="form-control" rows="5" asp-for="ProductDescription"></textarea>
                        </div>
                        <div class="form-group">
                            <label>@L["Admin_HighlightList_ProductImage"]</label>
                            <div class="product-image-container">
                                <img src="@Model.ProductImageURL"
                                     alt="@Model.ProductName"
                                     id="previewImage"
                                     class="highlight-product-image"/>
                                <div class="product-image-actions">
                                    <button type="button"
                                            class="btn btn-primary"
                                            onclick="document.getElementById('imageFileInput').click();">
                                        @L["Admin_GalleryUpdate_ChangeButton"]
                                    </button>
                                    <span id="selectedFileName"
                                          style="margin-left: 10px; color: #666; font-size: 12px;"></span>
                                </div>
                                <input type="file"
                                       id="imageFileInput"
                                       class="hidden-file-input"
                                       asp-for="ImageFile"
                                       accept="image/*"
                                       onchange="handleFileSelect(this)"/>
                            </div>
                        </div>
                        <div class="form-group">
                            <button class="btn btn-primary">@L["Admin_ProductUpdate_SubmitButton"]</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
<script>
    function handleFileSelect(input) {
        if (input.files && input.files[0]) {
            var file = input.files[0];
            document.getElementById('selectedFileName').textContent = file.name;
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewImage').src = e.target.result;
            };
            reader.readAsDataURL(file);
        }
    }
</script>


