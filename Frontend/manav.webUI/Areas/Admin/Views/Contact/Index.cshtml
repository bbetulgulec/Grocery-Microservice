@model List<ResultContactDto>
@{
    ViewBag.Title = "Contact List";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>İsim Soyisim</th>
                        <th>Email</th>
                        <th>Konu</th>
                        <th>İçerik</th>
                        <th>Durum</th>
                        <th>Sil</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.ContactName</td>
                            <td>@item.ContactEmail</td>
                            <td>@item.ContactSubject</td>
                            <td>@item.ContactMessage</td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-success">Okundu</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Okunmadı</span>
                                }
                            </td>
                            <td><a href='/Admin/Contact/DeleteContact/@item.ContactId' class="btn btn-danger"> Sil</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section> 
