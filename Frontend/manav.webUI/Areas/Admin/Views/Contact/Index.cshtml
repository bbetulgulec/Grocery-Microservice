@model List<ResultContactDto>
@{
    ViewBag.Title = L["Admin_Contact_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}

<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_Contact_FullName"]</th>
                        <th>@L["Admin_About_Mail"]</th>
                        <th>@L["Admin_Contact_Subject"]</th>
                        <th>@L["Admin_Contact_Message"]</th>
                        <th>@L["Admin_Comment_Status"]</th>
                        <th>@L["Delete"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.ContactName</td>
                            <td>@item.ContactEmail</td>
                            <td>@item.ContactSubject</td>
                            <td>@item.ContactMessage</td>
                            <td>
                                @if (item.IsRead)
                                {
                                    <span class="badge bg-success">@L["Admin_Contact_Read"]</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@L["Admin_Contact_Unread"]</span>
                                }
                            </td>
                            <td><a href='/Admin/Contact/DeleteContact/@item.ContactId'
                                   class="btn btn-danger"> @L["Delete"]</a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section> 
