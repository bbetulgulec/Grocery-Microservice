@model List<ResultAddressDto>
@{
    ViewBag.Title = L["Admin_OrderAddress_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_OrderAddress_AddressId"]</th>
                        <th>@L["Admin_OrderAddress_AddressDetail"]</th>
                        <th>@L["Admin_OrderAddress_FirstName"]</th>
                        <th>@L["Admin_OrderAddress_LastName"]</th>
                        <th>@L["Admin_OrderAddress_Phone"]</th>
                        <th>@L["Admin_OrderAddress_Email"]</th>
                        <th>@L["Delete"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.adressID</td>
                            <td>@item.addressDetail</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Number</td>
                            <td>@item.Email</td>
                            <td><a href='/Admin/Order/DeleteAddress/@item.adressID'
                                   class="btn btn-danger"> @L["Delete"]</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/Order/CreateOrder/"
                   class="btn btn-success btn-top-space"> @L["Admin_OrderAddress_AddNewButton"] </a>
            </div>
        </div>
    </div>
</section> 
