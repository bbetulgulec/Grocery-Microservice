@model List<ResultAddressDto>
@{
    ViewBag.Title = "Order";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>AdresId</th>
                        <th>Adres Detayı</th>
                        <th>Kullanıcı Adı</th>
                        <th>Kullanıcı Soyadı</th>
                        <th>Kullanıcı Telefonu</th>
                        <th>Kullanıcı Emaili</th>
                        <th>Sil</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.adressID</td>
                            <td>@item.addressDetail</td>
                            <td>@item.FirstName</td>
                            <td>@item.LastName</td>
                            <td>@item.Number</td>
                            <td>@item.Email</td>
                            <td><a href='/Admin/Order/DeleteAddress/@item.adressID' class="btn btn-danger"> Sil</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <a href="/Admin/Order/CreateOrder/" class="btn btn-success btn-top-space"> Yeni Adress girişi </a>
            </div>
        </div>
    </div>
</section> 
