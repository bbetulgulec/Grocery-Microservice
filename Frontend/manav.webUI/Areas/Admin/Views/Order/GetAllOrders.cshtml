@model List<UserOrderSummaryDto>
@{
    ViewBag.Title = L["Admin_OrderSummary_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    var count = 0;
}
<section class="content container-fluid">
    <div class="row">
        <div class="col-md-12">
            <div class="bs-example" data-example-id="bordered-table">
                <table class="table table-bordered">
                    <thead>
                    <tr>
                        <th>#</th>
                        <th>@L["Admin_OrderSummary_UserId"]</th>
                        <th>@L["Admin_OrderSummary_TotalOrder"]</th>
                        <th>@L["Admin_OrderSummary_LastOrderDate"]</th>
                        <th>@L["Admin_OrderSummary_OrderList"]</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        count++;
                        <tr>
                            <th scope="row">@count</th>
                            <td>@item.UserID</td>
                            <td><span class="badge bg-info">@item.TotalOrderCount @L["Admin_OrderSummary_Unit"]</span>
                            </td>
                            <td>@item.LastOrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <a href="/Admin/Order/OrderListByUserId/@item.UserID"
                                   class="btn btn-primary btn-sm">
                                    @L["Admin_OrderSummary_ListOrdersButton"]
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>