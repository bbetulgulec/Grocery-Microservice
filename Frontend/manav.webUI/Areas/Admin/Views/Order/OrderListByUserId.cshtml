@model List<ResultOrderingByUserIdDto>
@{
    ViewBag.Title = L["Admin_UserOrderDetails_Title"];
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}
<section class="orders-page">
    <header class="orders-heading">
        <div>
            <h1>@L["Admin_UserOrderDetails_Title"]</h1>
            <p>@L["Admin_UserOrderDetails_Subtitle"]</p>
        </div>
        <a href="/Admin/Order/GetAllOrders" class="orders-back">
            <span class="back-arrow" aria-hidden="true">&larr;</span>
            @L["Admin_UserOrderDetails_BackToList"]
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="orders-list">
            @foreach (var order in Model)
            {
                <article class="order-card">
                    <header class="order-card-head">
                        <div class="order-meta">
                            <span class="order-number">@L["Admin_UserOrderDetails_OrderPrefix"] @order.OrderingID</span>
                            <time class="order-date">
                                @order.OrderDate.ToString("dd MMMM yyyy, HH:mm")
                            </time>
                        </div>

                        <div class="order-total">
                            <span class="order-total-label">@L["Admin_UserOrderDetails_TotalLabel"]</span>
                            <span class="order-total-value">
                                @order.TotalPrice.ToString("N2") ₺
                            </span>
                        </div>

                    </header>
                    <div class="order-table-wrap">
                        <table class="order-table">
                            <thead>
                            <tr>
                                <th scope="col">#</th>
                                <th scope="col">@L["Admin_HighlightList_Product"]</th>
                                <th scope="col">@L["Admin_UserOrderDetails_TableHeaderUnitPrice"]</th>
                                <th scope="col" class="item-qty">@L["Admin_OrderSummary_Unit"]</th>
                                <th scope="col"
                                    style="text-align:right">@L["Admin_UserOrderDetails_TableHeaderSubtotal"]</th>
                            </tr>
                            </thead>

                            <tbody>
                            @if (order.OrderDetails != null && order.OrderDetails.Any())
                            {
                                var detailCount = 0;

                                @foreach (var detail in order.OrderDetails)
                                {
                                    detailCount++;

                                    <tr>
                                        <td class="item-index">@detailCount</td>
                                        <td class="item-name">@detail.ProductName</td>
                                        <td class="item-price">@detail.ProductPrice.ToString("N2")</td>
                                        <td class="item-qty">
                                                <span class="quantity-tag">
                                                    @detail.ProductAmount @L["Admin_OrderSummary_Unit"]
                                                </span>
                                        </td>
                                        <td class="item-subtotal">
                                            @detail.ProductTotalPrice.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="order-empty-items">
                                        @L["Admin_UserOrderDetails_EmptyItems"]
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="orders-empty">
            <div class="orders-empty-icon">
                <i class="fa-regular fa-clipboard" aria-hidden="true"></i>
            </div>
            <h2>@L["Admin_UserOrderDetails_EmptyOrdersTitle"]</h2>
            <p>@L["Admin_UserOrderDetails_EmptyOrdersText"]</p>
        </div>
    }
</section>