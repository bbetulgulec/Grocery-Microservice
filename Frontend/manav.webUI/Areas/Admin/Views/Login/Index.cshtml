@model manav.DtoLayer.IdentityDtos.LoginDto.CreateLoginDto
@{
    ViewBag.Title = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewBag.Title</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/MainDownload-OvioAdmin-html5-template/html/dist/css/style.css"/>
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.10.5/font/bootstrap-icons.min.css">

    <style>
        .login-card {
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1) !important;
        }

        .login-card .form-control {
            height: 45px;
            border-radius: 6px;
            border: 1px solid #d2d6de;
        }

        .login-card .form-control:focus {
            border-color: #002628;
            box-shadow: none;
        }
    </style>
</head>

<body class="body-bg-color min-vh-100 d-flex align-items-center justify-content-center p-3 p-md-4">

<div class="card login-card border-0 overflow-hidden w-100" style="max-width: 460px;">
    <div class="p-4 p-lg-5 text-dark bg-white">

        <div class="d-flex align-items-center justify-content-between mb-4">
            <h2 class="fw-bold mb-0 text-dark">Giriş Yap</h2>

            <a asp-controller="Default" asp-action="Index"
               class="text-secondary text-decoration-none small d-flex align-items-center gap-1">
                <i class="bi bi-house-door"></i>
                Siteye Dön
            </a>
        </div>

        <form asp-controller="Login" asp-action="Index" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-dark fw-semibold small mb-1">
                    E-Posta Adresi
                </label>
                <input asp-for="Email"
                       type="email"
                       class="form-control"
                       placeholder="ornek@email.com"
                       required/>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label text-dark fw-semibold small mb-1">
                    Şifre
                </label>
                <input asp-for="Password"
                       type="password"
                       class="form-control"
                       placeholder="••••••••"
                       required/>
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <button type="submit"
                    class="btn btn-dark w-100 d-flex align-items-center justify-content-center gap-2">
                <i class="bi bi-box-arrow-in-right"></i>
                Giriş Yap
            </button>

        </form>
    </div>
</div>

</body>
</html>